# Public site URL used for Open Graph / Twitter cards
NEXT_PUBLIC_SITE_URL=https://devvv.online

# Local SQLite (default): no env needed — uses data/portfolio.db
#
# Free remote DB (Turso / libSQL):
# 1. https://turso.tech — create a free database
# 2. Copy URL + token below
#
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Spotify live listening (Premium not required to read now-playing)
# 1. https://developer.spotify.com/dashboard — create an app
# 2. Add redirect URI: http://127.0.0.1:3000/api/spotify/callback
#    (and your production origin + /api/spotify/callback)
# 3. Set CLIENT_ID + CLIENT_SECRET below
# 4. Locally: open /api/spotify/authorize , copy SPOTIFY_REFRESH_TOKEN
# 5. For production setup once: SPOTIFY_ALLOW_SETUP=1 then remove it
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=
SPOTIFY_ALLOW_SETUP=
